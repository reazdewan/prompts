{
  // "name" must match the Worker name in Cloudflare (prompts.motionview.workers.dev).
  "name": "prompts",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Library PDFs go through src/worker.js first, so they can only be read in the Library reader.
    "run_worker_first": ["/books/*"]
  }
}
